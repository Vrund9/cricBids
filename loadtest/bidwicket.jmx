<stringProp name="script">if (vars.get('pinned') == null) {
  def base = org.apache.jmeter.services.FileServer.getFileServer().getBaseDir()
  def lines = new File(base, 'teams.csv').readLines().findAll { it.trim() }
  def header = lines[0].split(',') as List
  def row = lines[1 + (ctx.getThreadNum() % (lines.size() - 1))].split(',')
  ['bidToken': 'myBid'].each { src, dst -&gt; vars.put(dst, row[header.indexOf(src)]) }
  vars.put('pinned', '1')
}</stringProp>
</JSR223PreProcessor>
