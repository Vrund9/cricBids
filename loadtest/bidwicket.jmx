<JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Pin auction to VU">
<stringProp name="scriptLanguage">groovy</stringProp>
<stringProp name="parameters"></stringProp>
<stringProp name="filename"></stringProp>
<stringProp name="cacheKey">true</stringProp>
<stringProp name="script">if (vars.get('pinned') == null) {
  def base = org.apache.jmeter.services.FileServer.getFileServer().getBaseDir()
  def lines = new File(base, 'auctioneer.csv').readLines().findAll { it.trim() }
  def header = lines[0].split(',') as List
  def row = lines[1 + (ctx.getThreadNum() % (lines.size() - 1))].split(',')
  ['email': 'myEmail', 'password': 'myPassword', 'tournamentId': 'myTid'].each { src, dst -&gt; vars.put(dst, row[header.indexOf(src)]) }
  vars.put('pinned', '1')
}</stringProp>
</JSR223PreProcessor>
<hashTree>

</hashTree>
