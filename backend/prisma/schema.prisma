// BidWicket data model.
// Run `npm run db:migrate` after changing this file.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TournamentStatus {
  DRAFT
  READY
  LIVE
  PAUSED
  COMPLETED
}

enum PlayerStatus {
  AVAILABLE
  LIVE
  SOLD
  UNSOLD
}

enum PlayerSource {
  EXCEL
  FORM
  MANUAL
}

enum PlayerOrder {
  RANDOM
  CATEGORY_RANDOM
  SEQUENTIAL
}

enum TournamentPlan {
  FREE
  PRO
}

enum BidSource {
  AUCTIONEER
  REMOTE
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  /// Null for accounts created with Google sign-in until they set a password.
  passwordHash    String?
  /// Google account "sub" claim, set when the user signs in with Google.
  googleId        String?      @unique
  name            String
  avatarUrl       String?
  resetTokenHash  String?
  resetTokenExp   DateTime?
  /// Yearly "Season Pass": every tournament this user owns gets Pro features until this date.
  seasonPassUntil DateTime?
  /// Platform admin (can open /admin). Emails in ADMIN_EMAILS are admins regardless of this flag.
  isAdmin         Boolean      @default(false)
  /// Suspended accounts can't sign in or use the API.
  suspendedAt     DateTime?
  lastLoginAt     DateTime?
  /// Bumped on every sign-in; tokens carry it, so signing in on a new device signs the old one out.
  sessionVersion  Int          @default(0)
  /// Reward points balance: earned by sending feedback, spent as a discount on plans.
  rewardPoints    Int          @default(0)
  /// Auctions ever created (deleting one doesn't lower it): the 4th onwards carry an auction fee.
  auctionsCreated Int          @default(0)
  /// Everything unlocked for free — set by redeeming a plan code, cleared when the code is revoked.
  fullAccess      Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  tournaments     Tournament[]
  payments        Payment[]
  feedback        Feedback[]
  planCode        PlanCode?    @relation("RedeemedCode")
}

/// One-time codes an admin hands out to give an account full access (early customers, exceptions).
model PlanCode {
  id           String    @id @default(cuid())
  code         String    @unique
  note         String?
  createdById  String?
  redeemedById String?   @unique
  redeemedBy   User?     @relation("RedeemedCode", fields: [redeemedById], references: [id], onDelete: SetNull)
  redeemedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
}

enum FeedbackType {
  SUGGESTION
  BUG
}

enum FeedbackStatus {
  NEW
  REVIEWED
  RESOLVED
  /// Rejected as spam: the points it earned are taken back.
  REJECTED
}

/// Suggestions and bug reports sent from the account page. Each one earns reward points.
model Feedback {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       FeedbackType
  title      String
  message    String
  /// Page the user was on, or any context they added
  page       String?
  status     FeedbackStatus @default(NEW)
  /// Points awarded for this entry (taken back if rejected)
  points     Int            @default(0)
  adminNote  String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([userId])
  @@index([createdAt])
}

enum PaymentKind {
  /// Legacy plans, kept for payment history
  TOURNAMENT_PRO
  SEASON_PASS
  /// Pay-per-use: teams above the free 6
  EXTRA_TEAMS
  /// Pay-per-use: theme, colour and background customisation
  THEME_UNLOCK
  /// Pay-per-use: the 4th and later auctions
  AUCTION_FEE
  /// Pay-per-use: one-click random auction by grade
  RANDOM_AUCTION
}

enum PaymentSource {
  /// BILLING_MODE=demo: activated instantly, nothing charged
  DEMO
  /// Granted by an admin from the admin panel
  ADMIN
  /// Real payment through a gateway
  GATEWAY
}

/// One row per plan activation — the revenue / paid-user history shown in the admin panel.
model Payment {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournamentId String?
  tournament   Tournament?   @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  kind         PaymentKind
  /// Whole rupees actually charged (0 for demo/admin grants)
  amount       Int           @default(0)
  currency     String        @default("INR")
  source       PaymentSource
  note         String?
  /// List price in whole rupees before any reward discount
  listPrice    Int           @default(0)
  /// Reward discount applied, e.g. 10 for 10% off
  discountPct  Int           @default(0)
  /// Reward points spent on this purchase
  pointsUsed   Int           @default(0)
  /// Units bought, e.g. number of extra teams
  quantity     Int           @default(1)
  createdAt    DateTime      @default(now())

  @@index([userId])
  @@index([createdAt])
}

/// Platform-wide settings editable from the admin panel (key → JSON value).
model AppSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// Every change made from the admin panel.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String
  action     String
  targetType String?
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model Tournament {
  id              String           @id @default(cuid())
  ownerId         String
  owner           User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  slug            String           @unique
  logoUrl         String?
  description     String?
  venue           String?
  auctionDate     DateTime?
  currency        String           @default("INR")
  status          TournamentStatus @default(DRAFT)
  /// PRO = everything unlocked (legacy purchases and admin grants)
  plan            TournamentPlan   @default(FREE)
  planActivatedAt DateTime?
  /// This is the owner's Nth auction (1-based), fixed at creation
  sequence        Int              @default(0)
  /// Paid teams on top of the free allowance
  extraTeams      Int              @default(0)
  /// Paid theme customisation
  themeUnlocked   Boolean          @default(false)
  /// Paid auction fee (needed from the owner's 4th auction)
  auctionFeePaid  Boolean          @default(false)
  /// Paid one-click random auction
  randomUnlocked  Boolean          @default(false)
  /// Look of the public screens: { preset, accent?, hideBranding? }
  theme           Json?

  // Auction rules — answered in the setup wizard
  teamPurse          Int         @default(100000)
  basePrice          Int         @default(2000)
  /// Array of { from: number, step: number } sorted by `from`. Step that applies is the last tier whose `from` <= current bid.
  bidIncrements      Json
  /// Players are grouped into categories (A, B, C…): shapes the player list, registration form and Excel template.
  useCategories      Boolean     @default(false)
  /// The categories on offer when `useCategories` is on, in display order.
  categoryList       String[]    @default([])
  /// Optional map of category -> base price, e.g. { "A": 10000, "B": 5000 }
  categoryBasePrices Json?
  minSquad           Int         @default(11)
  maxSquad           Int         @default(15)
  playerOrder        PlayerOrder @default(RANDOM)
  /// Seconds of the visible countdown after each bid. 0 disables the timer.
  bidTimerSec        Int         @default(0)
  setupComplete      Boolean     @default(false)

  // Player self-registration (shareable form)
  registrationOpen   Boolean @default(false)
  registrationToken  String  @unique
  /// Which optional standard fields + custom questions the registration form asks.
  registrationFields Json
  requireApproval    Boolean @default(false)

  // Public live link + team bidding links
  liveToken     String  @unique
  remoteBidding Boolean @default(false)

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  teams     Team[]
  players   Player[]
  bids      Bid[]
  state     AuctionState?
  payments  Payment[]

  @@index([ownerId])
}

model Team {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  shortName    String
  color        String
  logoUrl      String?
  ownerName    String?
  /// Remaining purse
  purse        Int
  /// Secret token for the team owner's remote bidding paddle
  bidToken     String     @unique
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  players      Player[]
  bids         Bid[]

  @@index([tournamentId])
}

model Player {
  id           String       @id @default(cuid())
  tournamentId String
  tournament   Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  serial       Int
  name         String
  role         String
  category     String?
  battingStyle String?
  bowlingStyle String?
  phone        String?
  email        String?
  city         String?
  age          Int?
  photoUrl     String?
  /// Overrides tournament/category base price when set
  basePrice    Int?
  /// Kept by a team before the auction (never goes under the hammer)
  retained     Boolean      @default(false)
  /// Any additional columns from Excel or custom registration answers
  extra        Json?
  approved     Boolean      @default(true)
  source       PlayerSource @default(MANUAL)
  status       PlayerStatus @default(AVAILABLE)
  soldTeamId   String?
  soldTeam     Team?        @relation(fields: [soldTeamId], references: [id], onDelete: SetNull)
  soldPrice    Int?
  soldAt       DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  bids         Bid[]

  @@unique([tournamentId, serial])
  @@index([tournamentId, status])
}

model Bid {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  playerId     String
  player       Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  teamId       String
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  amount       Int
  round        Int
  source       BidSource  @default(AUCTIONEER)
  createdAt    DateTime   @default(now())

  @@index([playerId, round])
  @@index([tournamentId, createdAt])
}

/// Live auction cursor. One row per tournament; `version` provides optimistic locking so
/// two bids arriving at once can never both win.
model AuctionState {
  tournamentId    String     @id
  tournament      Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  currentPlayerId String?
  currentBid      Int?
  leadingTeamId   String?
  round           Int        @default(1)
  /// Remaining player ids in the order they will come up
  queue           String[]
  timerEndsAt     DateTime?
  version         Int        @default(0)
  lastEvent       Json?
  startedAt       DateTime?
  updatedAt       DateTime   @updatedAt
}
