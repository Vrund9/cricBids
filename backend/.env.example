# Postgres. Works out of the box with `npm run db:local` (embedded) or `npm run db:up` (Docker) — both listen on 5433.
DATABASE_URL="postgresql://cricbid:cricbid@localhost:5433/cricbid?schema=public"

PORT=4000
# Comma separated list of allowed web origins
WEB_ORIGIN="http://localhost:3000"
# Public URL of this API (used to build absolute upload URLs)
API_PUBLIC_URL="http://localhost:4000"

# Optional: store uploaded photos on Cloudinary (needed on hosts without a persistent disk, e.g. Render free).
# From Cloudinary Dashboard → API Keys: cloudinary://<api_key>:<api_secret>@<cloud_name>. Empty = save to ./uploads.
CLOUDINARY_URL=""
CLOUDINARY_FOLDER="bidwicket-local"

# Use a long random string in production: openssl rand -hex 32
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# Optional: Google sign-in. OAuth "Web application" client ID from Google Cloud Console
# (same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID in the frontend). Leave empty to disable.
GOOGLE_CLIENT_ID=""

# Optional SMTP for password reset mail. When empty, reset links are logged to the console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="BidWicket <no-reply@bidwicket.co.in>"
